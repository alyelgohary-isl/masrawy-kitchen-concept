---
/* Footer: the current masrawykitchen.com footer, word for word (About, Get News & Offers, Contacts),
   plus one row of links to the pages the rebuild adds. */
import { site, phone, phoneHref, address, mapsUrl } from "../site.config";
import { url } from "../lib/url";

const [ar, en] = site.brand;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url()}><span class="brand-ar" lang="ar">{ar}</span><span class="brand-en">{en}</span></a>
        <h3 style="margin-top:22px">About</h3>
        <p>{site.footer.about}</p>
        <a class="btn btn-ghost" href={url("menu/")}>See our Menu</a>
      </div>
      <div class="footer-col footer-news">
        <h3>Get News &amp; Offers</h3>
        <form class="news-form" novalidate="false">
          <label class="visually-hidden" for="news-email">Email</label>
          <input id="news-email" type="email" name="email" placeholder="Email address" required />
          <button class="btn btn-solid btn-sm" type="submit">Subscribe</button>
        </form>
        <div class="form-success" style="margin-top:0.8rem;padding:0.9rem 1rem"><p>You're on the list.</p></div>
        <p class="note">{site.footer.newsletterNote}</p>
      </div>
      <div class="footer-col footer-contact">
        <h3>Contacts</h3>
        <address>
          <a href={mapsUrl} target="_blank" rel="noopener">{address.street}<br />{address.city}, {address.region}, Canada</a>
          <a href={phoneHref}>{phone}</a>
        </address>
        <a class="btn btn-ghost" href={url("contact/")}>Contact us Today!</a>
      </div>
    </div>
    <nav class="footer-links" aria-label="Pages">
      {site.footer.links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
    </nav>
    <div class="footer-legal">
      <p>Copyright &copy; {year} {site.footer.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
