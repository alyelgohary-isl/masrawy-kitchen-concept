---
import Layout from "@/layouts/Layout.astro";
import ScrubHero from "@/components/ScrubHero.astro";
import { orderUrl, brunchHours } from "@/site.config";
import { url, absolute, SITE_URL } from "@/lib/url";
import { brunch } from "@/data/menu";

const tagClass = (t: string) => t.toLowerCase().includes("vegan") ? "tag vegan" : "tag";
const faq = [
  { q: "What time is brunch at Masrawy?", a: "Every day from 10am to 2pm, including weekdays. On the Nile is weekends only." },
  { q: "Do I need a reservation for brunch?", a: "Tables for eight or more can be reserved; smaller groups are first come, first served. Weekends are the busiest." },
  { q: "Is there a vegan brunch option?", a: "Yes: ful madames, tamaaya and pickled eggplant are vegan. Feteer and the egg plates are vegetarian." },
  { q: "What is feteer?", a: "A flaky, many-layered Egyptian pastry. Masrawy serves it as Sweet Cleopatra, with feta mix and molasses and tahina or honey." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute() },
    { "@type": "ListItem", position: 2, name: "Brunch", item: absolute("brunch/") },
  ] },
  { "@context": "https://schema.org", "@type": "Menu", "@id": `${SITE_URL}/brunch/#menu`, name: "Breakfast and brunch menu",
    hasMenuSection: brunch.map((s) => ({ "@type": "MenuSection", name: s.title, hasMenuItem: s.items.map((i) => ({ "@type": "MenuItem", name: i.name, ...(i.desc ? { description: i.desc } : {}), ...(i.price?.match(/\$(\d+(?:\.\d+)?)/) ? { offers: { "@type": "Offer", price: i.price.match(/\$(\d+(?:\.\d+)?)/)![1], priceCurrency: "CAD" } } : {}) })) })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Layout
  title="Egyptian Brunch in Mississauga | Masrawy Egyptian Kitchen"
  description="Egyptian breakfast every day 10am to 2pm: basterma and eggs, ful in a tajin, tamaaya, shakshuka and Sweet Cleopatra feteer with honey. Halal brunch in Mississauga, with prices."
  path="brunch/"
  current="brunch"
  schema={schema}
>
<main class="page">
  <ScrubHero id="feteer-scrub" frames="frames/feteer/fe_" poster="assets/img/feteer-honey-sq.webp" square label="Honey poured over feteer" hint="Scroll to pour">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span>Brunch</nav>
    <span class="ar-mark" lang="ar">فطار</span>
    <h1>Egyptian breakfast, <em>every day until two.</em></h1>
    <p class="lede">Ful and tamaaya the way Cairo eats them at 10am, eggs scrambled with basterma, and feteer pulled apart with honey. Served {brunchHours}.</p>
    <div class="hero-ctas"><a class="btn btn-solid" href={orderUrl} target="_blank" rel="noopener">Order for pick-up</a><a class="btn btn-ghost" href={url("reserve/")}>Reserve for eight or more</a></div>
  </ScrubHero>

  <div class="wrap">
    {brunch.map((s) => (
      <section class="menu-section" id={s.id}>
        <div class="menu-head"><h2>{s.title}{s.ar && <span class="ar" lang="ar">{s.ar}</span>}</h2></div>
        {s.note && <p class="menu-note">{s.note}</p>}
        <div class="menu-items">
          {s.items.map((i) => (
            <div class="menu-item">
              <div class="names">
                <h3>{i.slug ? <a href={url(`dishes/${i.slug}/`)}>{i.name}</a> : i.name}</h3>
                {i.ar && <span class="ar" lang="ar">{i.ar}</span>}
                {i.tags?.map((t) => <span class={tagClass(t)}>{t}</span>)}
              </div>
              <span class="price">{i.price ?? ""}</span>
              {i.desc && <p>{i.desc}</p>}
              {i.addons && <span class="addons">{i.addons}</span>}
            </div>
          ))}
        </div>
      </section>
    ))}
    <p class="micro" style="margin:28px 0 0">Prices from the current breakfast menu; subject to applicable taxes and may change without notice.</p>
  </div>

  <section class="photo-band" style="margin-top:72px">
    <img src={url("assets/img/brunch-eggs.webp")} alt="Egyptian breakfast plates: eggs, ful, home fries and balady bread" loading="lazy" />
    <div class="wrap"><h2><span class="ar" lang="ar">صباح الخير</span>Saba7 el-kher.</h2><p>Ful, two tamaaya and two eggs with balady bread, home fries and feta mix. The plate most of the room orders.</p></div>
  </section>

  <section class="section">
    <div class="wrap-narrow">
      <span class="eyebrow">Good to know</span>
      <div class="faq" style="margin-top:16px">
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</main>
</Layout>
