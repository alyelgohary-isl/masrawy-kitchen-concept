---
/* Home. The film captions the dish on screen (their menu wording and prices where they have them);
   the hero carries the current site's three buttons. Below the film the sections are the current
   masrawykitchen.com home page, word for word: Photo Gallery, Reviews, Restaurant Hours. */
import Layout from "@/layouts/Layout.astro";
import ScrollFilm from "@/components/motion/ScrollFilm.astro";
import { site, phone, phoneHref, orderUrl } from "@/site.config";
import { url } from "@/lib/url";
import * as film from "@/data/film";

const gallery: [string, string][] = [
  ["koshary", "Koshary with fried onions, dakka and hot sauce"],
  ["room-main", "The main dining room with string lights and patterned tile"],
  ["hawawshi", "Hawawshi cut and stacked, crisp balady bread around spiced beef"],
  ["feteer-honey", "Feteer served with honey and molasses"],
  ["spread-grill", "A mixed grill spread with rice, dips and bread"],
  ["room-mashrabiya", "A carved mashrabiya screen, back-lit"],
  ["macarona-bechamel", "Macarona bechamel in a clay pot with a golden top"],
  ["kunafa-syrup", "Syrup poured over kunafa"],
];

const reviews = [
  { title: "Your quality and care is what will bring me back.", who: "Aden A. Bemnet", text: "Thank you Masrawy Catering for serving us delicious food with impeccable service and ALWAYS on time! Your quality and care is what will bring me back. Can't wait til the next event to make another order!" },
  { title: "I've never tasted eggplant so delicious in my life!", who: "Fonna-Tasha S.", text: "After a long day of filming outside, being welcomed by a warm meal by Masrawy Fine Egyptian Catering was the HIGHLIGHT of my day - especially the Mussaka Masri. I've never tasted eggplant so delicious in my life! I would recommend Masrawy Fine Egyptian Catering for any production crew, workshop group, or major event." },
  { title: "Everyone absolutely loved the food!", who: "Basmah Elsisi", text: "I can't stress enough the amazing quality of the food, easy of planning and then to top it off, the service. Everything went so smoothly with the food and it's all thanks to you! Everyone absolutely loved the food! Great food, great quality, amazing prices and amazing service." },
  { title: "Never had Egyptian food before and I am an instant fan!", who: "Sabryn Rock", text: "Never had Egyptian food before and I am an instant fan! Variety, quality, great flavour. Highly recommend." },
  { title: "This food is amazing.", who: "B Jonathan Sanca", text: "This food is amazing. You can see this business is a labour of love and every dish is made with passion. Hands down the best Egyptian food I have ever had and quite possibly some of the best food I have ever tasted. Do yourself a favor and recommend masrawy to your family and friends. They won't be disappointed!!!!" },
];
---
<Layout
  title="Masrawy Egyptian Kitchen | Egyptian Restaurant in Mississauga"
  description="A Taste of Egypt in Mississauga: authentic Egyptian food made from original recipes with fresh 100% Halal ingredients. Dine-in, take-out, breakfast every day, events and catering."
  path=""
  variant="film"
>
  <ScrollFilm sources={film.sources} timeline={film.timeline} preload={film.preload} scrim={film.scrim} layout={film.layout} ground={film.ground} items=".beat-index, .beat-heading, .beat-body, .beat-price, .hero-ctas" loader={site.brand[1]}>
    <section class="band-section hero-section on-photo is-active" id="top" data-seg="hero:0,screen:0.55" data-animation="hero">
      <div class="hero-inner">
        <h1 class="hero-heading">
          <span class="line"><span class="word">A</span> <span class="word">Taste</span></span>
          <span class="line"><span class="word">of</span> <span class="word">Egypt</span></span>
        </h1>
        <p class="hero-tagline"><span>Dine-in &nbsp;|&nbsp; Take-out</span><span>Event &nbsp;|&nbsp; Catering</span></p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href={url("menu/")}>Main Menu</a>
          <a class="btn btn-ghost" href={url("brunch/")}>Breakfast Menu</a>
          <a class="btn btn-ghost" href={orderUrl} target="_blank" rel="noopener">Order Pick-up</a>
        </div>
      </div>
    </section>

    <section class="band-section" data-seg="coffee:0.1,h2:0.95" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index"><span class="ar" lang="ar">أهلاً</span></span>
        <h2 class="beat-heading">Welcome</h2>
        <p class="beat-body">Coffee from the kanaka before you've ordered, bread on the table, tea in a glass after. Hospitality is the first course.</p>
      </div>
    </section>

    <section class="band-section" data-seg="koshary:0.1,h3:0.95" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index"><span class="ar" lang="ar">كشري</span></span>
        <h2 class="beat-heading">Koshary</h2>
        <p class="beat-body">Rice, lentils, pasta, chickpeas, fried onions, spiced tomato sauce, dakka (garlic vinegar), hot sauce.</p>
        <span class="beat-price">$13 · Vegan</span>
      </div>
    </section>

    <section class="band-section" data-seg="tahina:0.1,h4:0.95" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index"><span class="ar" lang="ar">مشويات</span></span>
        <h2 class="beat-heading">Kofta, off the charcoal</h2>
        <p class="beat-body">Ground beef skewers, Egyptian spices, rice or fries, salata, tahina.</p>
        <span class="beat-price">Kofta $20 · Beef Kabab $27 · Hawaoshi $24</span>
      </div>
    </section>

    <section class="band-section on-photo" data-seg="hands:0.1,h5:0.95" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index"><span class="ar" lang="ar">سفرة</span></span>
        <h2 class="beat-heading">Everything is for the middle of the table.</h2>
        <p class="beat-body">Egyptian food is shared. Plates land, hands reach, and nobody orders just for themselves.</p>
        <div class="hero-ctas"><a class="btn btn-solid" href={url("menu/")}>Main Menu</a></div>
      </div>
    </section>

    <section class="band-section on-photo" data-seg="night:0.1,end:1" data-animation="fade-up">
      <div class="beat-copy">
        <span class="beat-index"><span class="ar" lang="ar">الصالة</span></span>
        <h2 class="beat-heading">Sixty seats. One room that feels like Cairo.</h2>
        <p class="beat-body">A semi-private room for thirty, a summer patio, and catering across the GTA since 2014.</p>
        <div class="hero-ctas"><a class="btn btn-solid" href={url("reserve/")}>Reserve a table</a><a class="btn btn-ghost" href={url("the-room/")}>See the room</a></div>
      </div>
    </section>
  </ScrollFilm>

  <main class="page-flow">
    <span class="flow-anchor" id="flow"></span>

    <section class="section" id="gallery">
      <div class="wrap">
        <div class="split-head">
          <div class="section-head reveal">
            <span class="eyebrow">Photo Gallery</span>
            <h2>What we make</h2>
          </div>
          <a class="btn btn-ghost reveal" href={url("gallery/")}>View All Photos</a>
        </div>
        <div class="home-gallery">
          {gallery.map(([img, alt]) => <a class="reveal" href={url("gallery/")}><img src={url(`assets/img/${img}.webp`)} alt={alt} loading="lazy" /></a>)}
        </div>
      </div>
    </section>

    <section class="section paper" id="reviews">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="eyebrow">Reviews</span>
          <h2>What they say</h2>
        </div>
        <ul class="reviews">
          {reviews.map((r) => <li class="reveal"><h3>“{r.title}”</h3><span class="who">— {r.who}</span><p>{r.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="section" id="hours">
      <div class="wrap hours-block">
        <div class="reveal">
          <span class="eyebrow">Restaurant Hours</span>
          <h3>Open</h3>
          <table class="hours">
            <tr><td>Sun to Thurs</td><td>10am – 10pm</td></tr>
            <tr><td>Fri to Sat</td><td>10am – 11pm</td></tr>
          </table>
          <h3>Breakfast</h3>
          <table class="hours">
            <tr><td>Everyday</td><td>10am – 2pm</td></tr>
          </table>
        </div>
        <div class="reveal">
          <p class="call">For private events and catering call us today!</p>
          <a class="phone" href={phoneHref}>{phone}</a>
          <div class="hero-ctas" style="margin-top:0"><a class="btn btn-solid" href={url("contact/")}>Contact Us</a></div>
        </div>
      </div>
    </section>
  </main>
</Layout>
