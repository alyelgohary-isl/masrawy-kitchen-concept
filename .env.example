# Copy to .env (gitignored). Never commit real keys.
KIE_API_KEY=            # kie.ai — Nano Banana 2 stills + Kling 3.0 clips (tools/kie.py)
GH_TOKEN=               # GitHub token with repo + Pages admin, only if `gh` is not logged in (tools/deploy.sh)

# Tracking (public IDs, not secrets). Production builds only; tools/deploy.sh copies them to the
# repo's Actions variables so the Pages build picks them up. Leave empty to ship without.
PUBLIC_GTM_ID=          # GTM-XXXXXXX: GA4 + the generate_lead key event live in the container
PUBLIC_GA4_ID=          # G-XXXXXXXXXX: only for sites without GTM (loads gtag.js directly)
PUBLIC_GSC_VERIFICATION= # Search Console HTML-tag token; skip if GSC is verified via GTM or DNS
